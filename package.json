{
  "name": "biblib",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": ">=10.32.1 <11"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test .next/tests/tests/*.test.js",
    "test:db": "node scripts/test-database.mjs",
    "test:smoke": "node scripts/smoke-app.mjs",
    "test:import": "tsc -p tsconfig.tests.json && node --test .next/tests/tests/library-import.test.js",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/migrate.mjs legacy",
    "test:scripts": "node --test \"tests/scripts/**/*.test.mjs\"",
    "dev:local": "node scripts/next-target.mjs dev local",
    "build:local": "node scripts/next-target.mjs build local",
    "start:local": "node scripts/next-target.mjs start local",
    "build:test": "node scripts/next-target.mjs build test",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "db:local:doctor": "node scripts/local-stack.mjs doctor",
    "db:local:status": "node scripts/local-stack.mjs status",
    "db:local:up": "node scripts/local-stack.mjs up",
    "db:local:down": "node scripts/local-stack.mjs down",
    "db:local:bootstrap": "node scripts/local-stack.mjs bootstrap",
    "db:status:local": "node scripts/db/migrate.mjs status local",
    "db:plan:local": "node scripts/db/plan.mjs local",
    "db:migrate:local": "node scripts/db/migrate.mjs apply local",
    "db:seed:local": "node scripts/db/seed-local.mjs",
    "db:local:login": "node scripts/db/local-login.mjs",
    "db:reset:local": "node scripts/local-stack.mjs reset",
    "test:integration:local": "node tests/integration/run.mjs",
    "db:backup:local": "node scripts/db/backup-local.mjs local",
    "db:backup:prod": "node scripts/db/backup-local.mjs prod",
    "db:restore:local": "node scripts/db/restore-local.mjs",
    "db:restore:verify": "node scripts/db/restore-verify.mjs",
    "db:local:credentials": "node scripts/db/local-credentials.mjs",
    "test:integration:catalogue": "node tests/integration/catalogue/run.mjs",
    "test:e2e:local": "node tests/e2e/run.mjs",
    "test:e2e:local:ui": "node tests/e2e/run.mjs --ui",
    "test:e2e:external": "node tests/e2e/run.mjs --external",
    "db:status:preprod": "node scripts/db/migrate.mjs status preprod",
    "db:status:prod": "node scripts/db/migrate.mjs status prod",
    "db:plan:preprod": "node scripts/db/plan.mjs preprod",
    "db:plan:prod": "node scripts/db/plan.mjs prod",
    "db:migrate:preprod": "node scripts/db/migrate.mjs apply preprod",
    "db:migrate:prod": "node scripts/db/migrate.mjs apply prod",
    "db:adopt:preprod": "node scripts/db/adopt.mjs preprod",
    "db:adopt:prod": "node scripts/db/adopt.mjs prod",
    "build:preprod": "node scripts/next-target.mjs build preprod",
    "build:prod": "node scripts/next-target.mjs build prod",
    "ci:release": "node scripts/ci/release.mjs",
    "ci:collect": "node scripts/ci/collect.mjs",
    "ci:test": "node --test scripts/ci/*.test.mjs",
    "test:integration:jobs": "node tests/integration/jobs/run.mjs",
    "jobs:run:local": "node scripts/jobs/run-local.mjs",
    "perf:local": "node scripts/performance/run.mjs",
    "perf:local:cleanup": "node scripts/performance/run.mjs cleanup",
    "security:headers:local": "node scripts/security/headers-local.mjs",
    "test:integration:security": "node tests/integration/security/run.mjs",
    "perf:catalogue": "node scripts/performance/catalogue-bench.mjs",
    "catalogue:telemetry": "node scripts/catalogue-telemetry.mjs",
    "perf:t4": "node scripts/performance/experiment-t4.mjs",
    "test:integration:snapshots": "node tests/integration/snapshots/run.mjs",
    "test:integration:views": "node tests/integration/views/run.mjs",
    "test:a11y:local": "node tests/accessibility/run.mjs",
    "test:integration:restore": "node tests/integration/restore/run.mjs",
    "perf:restore": "node scripts/performance/restore-bench.mjs",
    "test:integration:assets": "node tests/integration/assets/run.mjs",
    "assets:purge:local": "node scripts/jobs/purge-cover-assets.mjs",
    "test:integration:model": "node tests/integration/model/run.mjs",
    "account:deletions:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/account/deletions-local.mjs",
    "test:integration:account": "node tests/integration/account/run.mjs",
    "test:integration:product": "node tests/integration/product/run.mjs",
    "test:integration:review": "node tests/integration/review/run.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "^0.556.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.25",
    "supabase": "2.117.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3"
  }
}
