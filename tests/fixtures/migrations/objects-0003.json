 "functions": [
  {
   "name": "lock_library",
   "language": "plpgsql",
   "returns": "uuid",
   "args": 0,
   "config": [
    "search_path=pg_catalog"
   ],
   "security_definer": true,
   "body": "\nDECLARE\n  owner_id uuid := auth.uid();\n  current_revision uuid;\nBEGIN\n  IF owner_id IS NULL THEN\n    RAISE EXCEPTION 'lock_library requiere una sesión' USING ERRCODE = '42501';\n  END IF;\n  INSERT INTO biblib.library_state (user_id) VALUES (owner_id) ON CONFLICT (user_id) DO NOTHING;\n  SELECT state.revision INTO current_revision FROM biblib.library_state AS state WHERE state.user_id = owner_id FOR UPDATE;\n  RETURN current_revision;\nEND;\n",
   "execute_authenticated": true,
   "execute_anon": false
  },
  {
   "name": "rotate_book_version",
   "language": "plpgsql",
   "returns": "trigger",
   "args": 0,
   "config": [
    "search_path=pg_catalog"
   ],
   "security_definer": false,
   "body": "\nBEGIN\n  NEW.version := gen_random_uuid();\n  RETURN NEW;\nEND;\n",
   "execute_authenticated": true,
   "execute_anon": true
  },
  {
   "name": "rotate_library_revision",
   "language": "plpgsql",
   "returns": "trigger",
   "args": 0,
   "config": [
    "search_path=pg_catalog"
   ],
   "security_definer": true,
   "body": "\nDECLARE\n  owners uuid[];\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    owners := ARRAY[NEW.user_id];\n  ELSIF TG_OP = 'DELETE' THEN\n    owners := ARRAY[OLD.user_id];\n  ELSE\n    owners := ARRAY[NEW.user_id, OLD.user_id];\n  END IF;\n  INSERT INTO biblib.library_state AS state (user_id, rotated_xact)\n  SELECT DISTINCT owner_id, pg_current_xact_id() FROM unnest(owners) AS owner_id\n  WHERE EXISTS (SELECT 1 FROM auth.users AS account WHERE account.id = owner_id)\n  ON CONFLICT (user_id) DO UPDATE\n    SET revision = gen_random_uuid(), rotated_xact = excluded.rotated_xact, updated_at = now()\n    WHERE state.rotated_xact IS DISTINCT FROM excluded.rotated_xact;\n  RETURN NULL;\nEND;\n",
   "execute_authenticated": false,
   "execute_anon": false
  }
 ],
